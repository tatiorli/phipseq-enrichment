# Data — never commit. The FASTQs alone are ~4.6 GB and GitHub rejects >100 MB
# files. The pipeline downloads them from ENA, which is the point.
fastq/
counts/
ref/*.fasta
ref/*.bt2
*.sif
*.tar
*.tgz

# Large or regenerable outputs: the full count matrix and the per-feature
# statistics table. Everything else under results/ is committed on purpose,
# so a reader can see what the pipeline produced without running it:
#   enrichment_summary.tsv, enriched_peptides.tsv, library_qc.tsv
#   blast_annotation.tsv, blast/ (raw BLAST reports, ~1.6 MB)
#   motifs/ (STREME input and output, ~1.2 MB)
#   figures/
results/*.parquet
results/counts_matrix.tsv.gz
results/enrichment_all.tsv.gz

# Logs and scratch
logs/
probe.txt
quickstart.lsf
config/ena_raw.tsv
config/manifest.tsv

# Local secrets — belt and braces, nothing here should ever hold one
.env
*.token

# The job-application email is private; keep it out of the public repo
EMAIL_DRAFT.md

# VirScan library reference — 65 MB download, not ours to redistribute.
# scripts/08_annotate_vir3.py prints the command to fetch it.
data.tar.gz
data/
vir3_annotations.csv.gz
dataset.phip
